<h1>
    <%= title %>
</h1>
<p>
    <%= message %>
</p>
<a href="/grade/create">New Grade</a>
<table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
    <thead>
        <tr>
            <th>Grade</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        <% grades.forEach((grade)=> { %>
            <tr>
                <td>
                    <%= grade.grade_name %>
                </td>
                <td>
                    <a href="/grade/<%= grade.id %>/show">View</a>
                    <a href="/grade/<%= grade.id %>/edit">Edit</a>
                    <form action="/grade/<%= grade.id %>?_method=DELETE" method="post" style="display: inline;">

                        <input type="submit" value="Delete">
                    </form>
                </td>
            </tr>
            <% }); %>
    </tbody>
</table>