<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>

    <style>
        .container {
            background-color: #f2f2f2;
        }

        .header {
            background-color: #4CAF50;
            color: white;
            padding: 10px;
            text-align: center;
        }

        .footer {
            background-color: #4CAF50;
            color: white;
            padding: 10px;
            text-align: center;
        }
    </style>
</head>

<body>
    <table border="1" cellpadding="5" cellspacing="0" style="border-collapse: collapse; width: 100%;">
        <tr class="header" height="100">
            <td colspan="2">
                <h1>
                    <%= title %>
                </h1>
            </td>
        </tr>
        <tr height="400">
            <td width="20%">
                <ul>
                    <li><a href="/">Home</a></li>
                    <li><a href="/student">Students</a></li>
                    <li><a href="/grade">Grades</a></li>

                </ul>
            </td>
            <td class="content">

                <%- body %>

            </td>
        </tr>
        <tr height="100" class="footer">
            <td colspan="2">Footer</td>
        </tr>

    </table>

</body>

</html>